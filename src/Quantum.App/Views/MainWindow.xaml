<ui:FluentWindow x:Class="Quantum.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:sections="clr-namespace:Quantum.App.Views.Sections"
                 Title="Quantum"
                 Height="880" Width="1280" MinHeight="680" MinWidth="1080"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource HudBg}"
                 TextOptions.TextFormattingMode="Display">

    <Grid>
        <!-- O FluentWindow com backdrop "None" não honra o Background da janela: fica
             transparente e mostra preto. Pintar aqui é o que faz o tema claro valer. -->
        <Rectangle Fill="{DynamicResource HudBg}" IsHitTestVisible="False" />

        <!-- Grade de HUD ao fundo -->
        <Rectangle Fill="{DynamicResource HudGrid}" IsHitTestVisible="False" Opacity="0.55" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" Title="QUANTUM" ShowMaximize="True" />

            <!-- ============ Cabeçalho: contexto da seção + estado ============ -->
            <Border Grid.Row="1" Padding="22,2,22,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="36" Background="{DynamicResource NeonGradientV}"
                                Margin="0,0,14,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource HudTitle}" />
                            <TextBlock Text="{Binding SectionSubtitle}" Style="{StaticResource HudCaption}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource HudControl}" BorderBrush="{DynamicResource HudBorder}"
                                BorderThickness="1" CornerRadius="2" Padding="10,5" Margin="0,0,8,0"
                                ToolTip="{Binding HealthSummary}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource HudDanger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource HudOk}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding LastCheckupLabel}" FontSize="10.5"
                                           Foreground="{DynamicResource HudTextDim}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource HudControl}" BorderBrush="{DynamicResource HudBorder}"
                                BorderThickness="1" CornerRadius="2" Padding="10,5" Margin="0,0,8,0"
                                ToolTip="Trocar formato, áudio espacial e reiniciar o serviço exigem administrador">
                            <TextBlock Text="{Binding ElevationLabel}" FontSize="10.5" FontWeight="Bold"
                                       FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{DynamicResource NeonCyan}" />
                        </Border>

                        <Button Content="ELEVAR" Style="{StaticResource HudButton}" Margin="0,0,8,0"
                                Command="{Binding RestartElevatedCommand}"
                                Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="ATUALIZAR" Style="{StaticResource HudButton}"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Faixa de versão nova ============ -->
            <Border Grid.Row="2" Margin="22,0,22,14" Padding="16,13"
                    Background="{DynamicResource HudSurface}"
                    BorderBrush="{DynamicResource NeonCyan}" BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Style="{StaticResource HudIcon}" Width="20" Height="20"
                              Data="{StaticResource IconDownload}"
                              VerticalAlignment="Top" Margin="0,1,13,0" />

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="{Binding UpdateHeadline}" FontSize="13.5" FontWeight="Bold"
                                       FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{DynamicResource HudText}" />
                            <ScrollViewer MaxHeight="76" Margin="0,6,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding UpdateNotes}"
                                           Style="{StaticResource HudCaption}" />
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="{Binding UpdateActionLabel}"
                                    Style="{StaticResource HudButtonPrimary}"
                                    Padding="14,6" Margin="0,0,6,0"
                                    Command="{Binding ApplyUpdateCommand}" />
                            <Button Content="DEPOIS" Style="{StaticResource HudButton}" Padding="12,6"
                                    Command="{Binding DismissUpdateCommand}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Height="3" Margin="0,12,0,0" Maximum="100"
                                 Value="{Binding UpdateProgress, Mode=OneWay}"
                                 Foreground="{DynamicResource NeonCyan}"
                                 Background="{DynamicResource HudTrack}"
                                 BorderThickness="0"
                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- ============ Corpo: barra lateral + seção ============ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="98" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource HudRail}"
                        BorderBrush="{DynamicResource HudBorder}" BorderThickness="0,1,1,0">
                    <ListBox ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             Style="{StaticResource HudNavList}"
                             Margin="8,12,8,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource HudIcon}" Width="22" Height="22"
                                          HorizontalAlignment="Center"
                                          Data="{Binding Icon, Converter={StaticResource IconGeometry}}" />
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                               Margin="0,5,0,0" FontSize="10.5"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HudTextDim}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="1" BorderBrush="{DynamicResource HudBorder}" BorderThickness="0,1,0,0">
                    <Grid>
                        <sections:DashboardSection
                            Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}" />
                        <sections:DevicesSection
                            Visibility="{Binding IsDeviceSectionVisible, Converter={StaticResource BoolToVisibility}}" />
                        <sections:SettingsSection
                            Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Status ============ -->
            <Border Grid.Row="4" Background="{DynamicResource HudStatusBar}" BorderBrush="{DynamicResource HudBorder}"
                    BorderThickness="0,1,0,0" Padding="22,11">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Height="14" Background="{DynamicResource NeonGradientV}"
                            Margin="0,0,11,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{Binding StatusIsError, Converter={StaticResource StatusBrush}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
