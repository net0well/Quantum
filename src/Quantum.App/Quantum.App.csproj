<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Só pelo NotifyIcon da bandeja: é a API de tray mais estável do Windows. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Quantum.App</RootNamespace>
    <AssemblyName>Quantum</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\quantum.ico</ApplicationIcon>
    <!-- Entrada própria: o Velopack precisa rodar antes de a Application existir. -->
    <StartupObject>Quantum.App.Program</StartupObject>
    <!-- WFO0003 pede para tirar o DPI do manifesto e usar a API do WinForms. Aqui quem
         desenha é o WPF, que precisa das entradas de DPI no manifesto. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Description>Central de áudio do Windows: balanço por canal, qualidade, áudio espacial e perfis.</Description>

    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>

    <!-- Publicação portátil fica em publish.ps1 e no workflow, não aqui: são
         opções de publish, e fixá-las no csproj torna o projeto autocontido
         até para build comum — o que impede o projeto de teste de referenciá-lo. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- O app passa a maior parte do tempo ocioso na bandeja: GC de estação de
         trabalho, não concorrente, é o perfil que gasta menos memória e menos threads. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Os usings implícitos do WinForms colidem com os do WPF (Application, Color,
         MessageBox...). O único arquivo que usa WinForms importa o que precisa. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quantum.Audio\Quantum.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quantum.Audio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\quantum.ico" />
    <!-- Embutidas no assembly, então sobrevivem à publicação em arquivo único -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
