<!--
    Paleta clara. Mesmas chaves da escura — trocar o dicionário troca o app inteiro.

    Não é a escura invertida: num fundo claro os tons neon puros perdem contraste e
    viram borrão, então violeta e ciano descem de luminosidade até passarem em texto
    pequeno. O verde, o âmbar e o vermelho de estado seguem a mesma régua.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="NeonVioletColor">#FF6B3FE0</Color>
    <Color x:Key="NeonCyanColor">#FF0E8FA8</Color>
    <Color x:Key="NeonPinkColor">#FFD62E7A</Color>
    <Color x:Key="HudBgColor">#FFF3F4F7</Color>
    <Color x:Key="HudSurfaceColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="HudBg" Color="{StaticResource HudBgColor}" />
    <SolidColorBrush x:Key="HudSurface" Color="{StaticResource HudSurfaceColor}" />
    <SolidColorBrush x:Key="HudSurfaceHi" Color="#FFEDEFF4" />
    <SolidColorBrush x:Key="HudSurfaceSunken" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="HudControl" Color="#FFEFF1F5" />
    <SolidColorBrush x:Key="HudControlHover" Color="#FFE2E6EE" />
    <SolidColorBrush x:Key="HudSelected" Color="#FFE8EBF2" />
    <SolidColorBrush x:Key="HudBorder" Color="#FFD7DBE3" />
    <SolidColorBrush x:Key="HudBorderStrong" Color="#FFB6BDCA" />
    <SolidColorBrush x:Key="NeonViolet" Color="{StaticResource NeonVioletColor}" />
    <SolidColorBrush x:Key="NeonCyan" Color="{StaticResource NeonCyanColor}" />
    <SolidColorBrush x:Key="NeonPink" Color="{StaticResource NeonPinkColor}" />
    <SolidColorBrush x:Key="HudText" Color="#FF121620" />
    <SolidColorBrush x:Key="HudTextDim" Color="#FF565E70" />
    <SolidColorBrush x:Key="HudTextFaint" Color="#FF8A93A5" />
    <SolidColorBrush x:Key="HudTrack" Color="#FFDDE1E9" />
    <SolidColorBrush x:Key="HudOk" Color="#FF17805A" />
    <SolidColorBrush x:Key="HudWarn" Color="#FFA76A0E" />
    <SolidColorBrush x:Key="HudDanger" Color="#FFC22740" />
    <SolidColorBrush x:Key="HudRail" Color="#FFEAECF1" />
    <SolidColorBrush x:Key="HudStatusBar" Color="#FFEDEFF4" />
    <SolidColorBrush x:Key="HudOnAccent" Color="#FFFFFFFF" />

    <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource NeonVioletColor}" Offset="0" />
        <GradientStop Color="{StaticResource NeonCyanColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeonGradientV" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource NeonVioletColor}" Offset="0" />
        <GradientStop Color="{StaticResource NeonCyanColor}" Offset="1" />
    </LinearGradientBrush>

    <DrawingBrush x:Key="HudGrid" TileMode="Tile" Viewport="0,0,34,34"
                  ViewportUnits="Absolute" Opacity="0.6">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="0,0,34,1" />
                        <RectangleGeometry Rect="0,0,1,34" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Brush>
                    <SolidColorBrush Color="#FFE3E6EC" />
                </GeometryDrawing.Brush>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
