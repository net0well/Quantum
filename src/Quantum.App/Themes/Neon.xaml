<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Quantum.App.Controls">

    <!-- ================= Tipografia =================
         Três papéis: display embutida nos títulos e rótulos, a de sistema no texto
         corrido (que lê melhor em corpo pequeno) e monoespaçada nos números. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Quantum;component/Assets/Fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <Style x:Key="HudTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="Foreground" Value="{DynamicResource HudText}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="HudSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="HudCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HudTextDim}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <Style x:Key="HudValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <!-- Dígitos de largura fixa: sem isso os números dançam ao variar -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="HudValueDim" TargetType="TextBlock" BasedOn="{StaticResource HudValue}">
        <Setter Property="Foreground" Value="{DynamicResource HudText}" />
    </Style>

    <!-- ================= Ícones vetoriais =================
         Emoji não serve aqui: o Segoe UI Emoji desenha em cores próprias e vários
         glifos (fone, claquete, microfone) são pretos — somem no fundo escuro.
         Traçado em 24x24, colorido pelo Stroke, sempre visível. -->
    <PathGeometry x:Key="IconHeadphones"
                  Figures="M4 15 V12 A8 8 0 0 1 20 12 V15 M2.5 15 H6.5 V20 H2.5 Z M17.5 15 H21.5 V20 H17.5 Z" />

    <PathGeometry x:Key="IconSpeaker"
                  Figures="M3 9.5 H6.5 L11 5.5 V18.5 L6.5 14.5 H3 Z M14.5 9.5 A4 4 0 0 1 14.5 14.5 M17.5 6.5 A8 8 0 0 1 17.5 17.5" />

    <PathGeometry x:Key="IconMonitor"
                  Figures="M3 5 H21 V16.5 H3 Z M9.5 20.5 H14.5 M12 16.5 V20.5" />

    <PathGeometry x:Key="IconMicrophone"
                  Figures="M12 3 A3 3 0 0 1 15 6 V11 A3 3 0 0 1 9 11 V6 A3 3 0 0 1 12 3 Z M5.5 10.5 A6.5 6.5 0 0 0 18.5 10.5 M12 17.5 V21 M8.5 21 H15.5" />

    <PathGeometry x:Key="IconDigital"
                  Figures="M3 12 A9 9 0 0 1 21 12 A9 9 0 0 1 3 12 Z M8 12 A4 4 0 0 1 16 12 A4 4 0 0 1 8 12 Z" />

    <PathGeometry x:Key="IconAudio"
                  Figures="M3 9.5 H6.5 L11 5.5 V18.5 L6.5 14.5 H3 Z M14.5 9.5 A4 4 0 0 1 14.5 14.5" />

    <PathGeometry x:Key="IconTarget"
                  Figures="M3.5 12 A8.5 8.5 0 0 1 20.5 12 A8.5 8.5 0 0 1 3.5 12 Z M8.5 12 A3.5 3.5 0 0 1 15.5 12 A3.5 3.5 0 0 1 8.5 12 Z M12 1 V4.5 M12 19.5 V23 M1 12 H4.5 M19.5 12 H23" />

    <PathGeometry x:Key="IconFilm"
                  Figures="M3 6 H21 V19 H3 Z M3 10.5 H21 M7.5 6 L5.5 10.5 M12.5 6 L10.5 10.5 M17.5 6 L15.5 10.5" />

    <PathGeometry x:Key="IconNote"
                  Figures="M6 17.5 A2.5 2.5 0 0 1 11 17.5 A2.5 2.5 0 0 1 6 17.5 Z M15.5 15.5 A2.5 2.5 0 0 1 20.5 15.5 A2.5 2.5 0 0 1 15.5 15.5 Z M11 17.5 V5.5 L20.5 3.5 V15.5 M11 9 L20.5 7" />

    <PathGeometry x:Key="IconGauge"
                  Figures="M3.5 17.5 A9 9 0 0 1 20.5 17.5 M12 17.5 L16.5 11 M6.5 8 L7.8 9.3 M12 5.5 V7.3 M17.5 8 L16.2 9.3" />

    <PathGeometry x:Key="IconDownload"
                  Figures="M12 3 V15 M7 10.5 L12 15.5 L17 10.5 M4 19 H20" />

    <PathGeometry x:Key="IconSliders"
                  Figures="M3 7 H21 M3 12 H21 M3 17 H21 M8 4.8 V9.2 M15.5 9.8 V14.2 M6.5 14.8 V19.2" />

    <Style x:Key="HudIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource NeonCyan}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="21" />
        <Setter Property="Height" Value="21" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ================= Cartão HUD ================= -->
    <Style x:Key="HudCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HudSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HudBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- Faixa neon usada no topo dos cartões -->
    <Style x:Key="HudAccentBar" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{DynamicResource NeonGradient}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- ================= Botões ================= -->
    <Style x:Key="HudButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource HudText}" />
        <Setter Property="Background" Value="{DynamicResource HudControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HudBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HudControlHover}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
                            <Setter Property="Foreground" Value="{DynamicResource NeonCyan}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudButtonPrimary" TargetType="Button" BasedOn="{StaticResource HudButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{DynamicResource NeonGradient}"
                            CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextBlock.Foreground="{DynamicResource HudOnAccent}"
                                          TextBlock.FontWeight="Bold" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource NeonCyanColor}" BlurRadius="16"
                                                      ShadowDepth="0" Opacity="0.85" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alternador segmentado SAÍDA / ENTRADA -->
    <Style x:Key="HudSegment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="2" Padding="14,7"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter x:Name="Body" HorizontalAlignment="Center"
                                          TextBlock.Foreground="{DynamicResource HudTextDim}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HudControl}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HudSurfaceHi}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NeonGradient}" />
                            <Setter TargetName="Body" Property="TextBlock.Foreground" Value="{DynamicResource NeonCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Barra lateral de navegação ================= -->
    <Style x:Key="HudNavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Height="62">
                                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="3" />
                                    <Border x:Name="Edge" Width="3" HorizontalAlignment="Left"
                                            Background="{DynamicResource NeonGradientV}" Opacity="0"
                                            CornerRadius="2" Margin="0,8" />
                                    <ContentPresenter />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HudControl}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HudSelected}" />
                                        <Setter TargetName="Edge" Property="Opacity" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Slider ================= -->
    <Style x:Key="HudSliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudSliderFill" TargetType="RepeatButton" BasedOn="{StaticResource HudSliderRepeat}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource NeonGradient}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="16" Height="20">
                        <Rectangle x:Name="Body" Width="7" Height="18" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource HudText}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Fill" Value="{DynamicResource NeonCyan}" />
                            <Setter TargetName="Body" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource NeonCyanColor}" BlurRadius="14"
                                                      ShadowDepth="0" Opacity="0.9" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudSlider" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource HudTrack}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource HudSliderFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource HudThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource HudSliderRepeat}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudSliderCentered" TargetType="Slider" BasedOn="{StaticResource HudSlider}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource HudTrack}" />
                        <Border Width="2" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource HudTextFaint}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource HudSliderRepeat}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource HudThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource HudSliderRepeat}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Medidor de pico =================
         Desenhado em OnRender, com escala em dB, balística e traço de pico.
         As cores vêm do tema para acompanharem claro/escuro. -->
    <Style x:Key="HudMeter" TargetType="{x:Type controls:AudioLevelMeter}">
        <Setter Property="Height" Value="9" />
        <Setter Property="TrackBrush" Value="{DynamicResource HudTrack}" />
        <Setter Property="NormalBrush" Value="{DynamicResource NeonCyan}" />
        <Setter Property="WarningBrush" Value="{DynamicResource HudWarn}" />
        <Setter Property="DangerBrush" Value="{DynamicResource HudDanger}" />
        <Setter Property="PeakBrush" Value="{DynamicResource HudText}" />
        <Setter Property="ScaleBrush" Value="{DynamicResource HudTextFaint}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Versão alta, para o nível de entrada do microfone -->
    <Style x:Key="HudMeterTall" TargetType="{x:Type controls:AudioLevelMeter}"
           BasedOn="{StaticResource HudMeter}">
        <Setter Property="Height" Value="18" />
    </Style>

    <!-- Só a régua em dB: uma por grupo de medidores, em vez de repetir por canal -->
    <Style x:Key="HudScaleStrip" TargetType="{x:Type controls:AudioLevelMeter}"
           BasedOn="{StaticResource HudMeter}">
        <Setter Property="Height" Value="14" />
        <Setter Property="ShowBar" Value="False" />
        <Setter Property="ShowScale" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ================= Barra de rolagem ================= -->
    <Style x:Key="HudScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{DynamicResource HudBorderStrong}" CornerRadius="2" Margin="3,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource NeonViolet}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource HudSliderRepeat}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource HudScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource HudSliderRepeat}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Lista de dispositivos ================= -->
    <Style x:Key="HudDeviceList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,7" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid>
                                    <Border x:Name="Chrome" Background="{DynamicResource HudSurface}"
                                            BorderBrush="{DynamicResource HudBorder}" BorderThickness="1"
                                            CornerRadius="3" Padding="13,11,13,11" />
                                    <Border x:Name="Edge" Width="3" HorizontalAlignment="Left"
                                            Background="{DynamicResource NeonGradientV}" Opacity="0"
                                            CornerRadius="3,0,0,3" />
                                    <ContentPresenter Margin="16,11,13,11" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HudSurfaceHi}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HudSelected}" />
                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource HudBorderStrong}" />
                                        <Setter TargetName="Edge" Property="Opacity" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ComboBox ================= -->
    <Style x:Key="HudComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{DynamicResource HudControl}"
                            BorderBrush="{DynamicResource HudBorder}" BorderThickness="1"
                            CornerRadius="2" Padding="11,8">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="0,0,22,0" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource NeonCyan}"
                                  StrokeThickness="1.6" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource HudText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource HudComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextBlock.Foreground="{DynamicResource HudText}" />
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource HudSurfaceSunken}" BorderBrush="{DynamicResource HudBorderStrong}" BorderThickness="1"
                                    CornerRadius="2" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="280">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource HudText}" />
                    <Setter Property="Padding" Value="11,9" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Chrome" Background="Transparent" CornerRadius="2"
                                        Padding="{TemplateBinding Padding}" BorderThickness="2,0,0,0"
                                        BorderBrush="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HudControlHover}" />
                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HudSelected}" />
                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NeonViolet}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Switch ================= -->
    <Style x:Key="HudSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource HudText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Rail" Width="40" Height="20" CornerRadius="2"
                                Background="{DynamicResource HudTrack}"
                                BorderBrush="{DynamicResource HudBorder}" BorderThickness="1">
                            <Rectangle x:Name="Knob" Width="14" Height="12" RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource HudTextDim}"
                                       HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Margin="11,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource NeonGradient}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TextBox ================= -->
    <Style x:Key="HudTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource HudControl}" />
        <Setter Property="Foreground" Value="{DynamicResource HudText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource NeonCyan}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HudBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NeonCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
