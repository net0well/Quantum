<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Quantum.Audio.Tests</RootNamespace>
    <AssemblyName>Quantum.Audio.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 roda sobre a Microsoft Testing Platform, não sobre o VSTest. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseVSTest>false</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quantum.Audio\Quantum.Audio.csproj" />
    <!-- Alcança a lógica pura da camada de app (formatação de notas, conversores).
         Sem UseWPF de propósito: System.Windows.Shapes.Path colidiria com
         System.IO.Path nos testes, e nada aqui toca em tipo do WPF. -->
    <ProjectReference Include="..\..\src\Quantum.App\Quantum.App.csproj" />
  </ItemGroup>

</Project>
