<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Quantum.Audio.Tests</RootNamespace>
    <AssemblyName>Quantum.Audio.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 roda sobre a Microsoft Testing Platform, não sobre o VSTest. -->
