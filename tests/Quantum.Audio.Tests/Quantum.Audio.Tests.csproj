    <UseVSTest>false</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quantum.Audio\Quantum.Audio.csproj" />
  </ItemGroup>

</Project>
